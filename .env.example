# Honey-LLM backend configuration (copy to backend/.env — never commit the real .env)
# All values here are safe defaults for local development.

# --- App ---
APP_NAME=Honey-LLM Gateway
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Ollama (local inference) ---
OLLAMA_BASE_URL=http://localhost:11434
SIEVE_MODEL=llama-guard3:latest
RAG_MODEL=llama3:latest
DECOY_MODEL=llama3:latest
OLLAMA_TIMEOUT_S=30
OLLAMA_KEEP_ALIVE=10m
SIEVE_HISTORY_TURNS=6
EMBEDDING_MODEL=all-minilm:latest

# --- Guardrails (Phase 4): tier-0 synthesized Colang rules ---
# Rules live in guardrails/rails/*.co and hot-reload with no redeploy.
# Threshold is SEMANTIC (embedding cosine), calibrated: benign max 0.309 vs
# technique-variant min 0.543 -> 0.45 sits mid-margin. See docs/guardrail_synthesis.md
USE_GUARDRAILS=true
GUARDRAILS_RAILS_DIR=guardrails/rails
GUARDRAIL_MATCH_THRESHOLD=0.45
# Human-review checkpoint: true = passing rules wait in GUARDRAILS_PENDING_DIR
# for approval; false (default) = fully autonomous behind the two gates.
GUARDRAIL_REQUIRE_REVIEW=false
GUARDRAILS_PENDING_DIR=guardrails/pending

# --- Mirror Maze decoy (Phase 3) ---
# Empty = run the decoy in-process. Set to the isolated container's URL to route
# flagged sessions into the Docker sandbox (falls back to in-process if down):
#   DECOY_SERVICE_URL=http://localhost:9100
DECOY_SERVICE_URL=

# --- Fast-path (tier 1) classifier: TF-IDF + LogReg, ~2ms ---
# Below this score the request is resolved SAFE without calling the 8B Guard.
# CALIBRATED by ml/train_fast_path.py (see ml/models/fast_path_meta.json) to
# fast-pass ~zero attacks. Set USE_FAST_PATH=false to always use the Guard.
USE_FAST_PATH=true
FAST_PATH_MODEL_PATH=ml/models/fast_path.joblib
FAST_PATH_SAFE_THRESHOLD=0.15

# --- Legacy borderline band (reserved; used by a future continuous scorer) ---
SIEVE_THRESHOLD=0.5
SIEVE_BORDERLINE_LOW=0.4
SIEVE_BORDERLINE_HIGH=0.6

# --- Forensic log ---
FORENSIC_LOG_PATH=forensic_log.jsonl

# --- Admin / demo control panel (Phase 5) — authenticated (rules.md §4) ---
# Sent as the X-Admin-Token header from the /admin surface. Change for anything
# beyond a local demo.
ADMIN_TOKEN=honeyllm-demo-admin

# --- CORS (frontend dev server origins; comma-separated) ---
# Next.js defaults to :3000 but falls back to the next free port if taken —
# list the ports you actually use in dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3007
